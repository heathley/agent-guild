    "check": "npm run test && npm run typecheck:connector && npm run connector:smoke && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
