{
  "name": "agent-guild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck:connector": "tsc -p tsconfig.connector.json",
    "connector": "tsx connector/index.ts",
